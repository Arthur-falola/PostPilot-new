# GEMINI_API_KEY: Required for Gemini AI generation and analysis.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Database Connection (PostgreSQL):
# Either provide DATABASE_URL (recommended for Supabase, Neon, Render, Railway, Vercel Postgres):
DATABASE_URL="postgresql://user:password@host:5432/postpilot?sslmode=require"

# Or configure individual credentials:
SQL_HOST="your-db-host"
SQL_USER="your-db-user"
SQL_PASSWORD="your-db-password"
SQL_DB_NAME="postpilot"
SQL_PORT="5432"

# APP_URL: The public URL of your deployed application
APP_URL="https://your-domain.vercel.app"

